# Required: Anthropic API key used for both photo item-detection and inventory reconciliation.
ANTHROPIC_API_KEY=

# Required: signs and verifies login sessions. Generate a long random value
# once (e.g. `openssl rand -hex 32`) and keep it stable -- changing it
# invalidates every existing user's session, logging everyone out.
JWT_SECRET=

# Optional overrides.
PORT=3000
DATABASE_PATH=./data/packing.db
UPLOAD_DIR=./data/uploads
ANTHROPIC_VISION_MODEL=claude-sonnet-5
ANTHROPIC_MATCH_MODEL=claude-sonnet-5
