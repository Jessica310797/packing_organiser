{
  "expo": {
    "name": "Pakka",
    "slug": "pakka",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jessicaculnane.pakka",
      "infoPlist": {
        "NSCameraUsageDescription": "Used to take photos of items as you pack your suitcase.",
        "NSPhotoLibraryUsageDescription": "Used to select existing photos of your packed items."
      }
    },
    "android": {
      "package": "com.jessicaculnane.pakka",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Used to select existing photos of your packed items.",
          "cameraPermission": "Used to take photos of items as you pack your suitcase."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "941d5af3-8ee4-4634-9239-94ae87aa6f77"
      }
    }
  }
}
